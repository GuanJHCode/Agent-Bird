#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
binary="$root/bin/codex-orchestrator"
if [ ! -f "$binary" ] || [ ! -x "$binary" ]; then
  printf '%s\n' 'bridge_hook_runtime_unavailable' >&2
  exit 0
fi
exec "$binary" bridge hook --provider agy --native-hook PreInvocation --binding-file "${AGENT_BIRD_BRIDGE_BINDING-}"
