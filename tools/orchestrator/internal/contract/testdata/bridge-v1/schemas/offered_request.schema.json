{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-bird-bridge-v1/offered_request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 0,
      "const": 1
    },
    "binding_id": {
      "type": "string",
      "minLength": 1
    },
    "owner_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_token": {
      "type": "string",
      "minLength": 1,
      "x-secret": true
    },
    "wire_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "binding_id",
    "owner_epoch",
    "request_id",
    "batch_id",
    "attempt_id",
    "claim_token",
    "wire_sha256"
  ]
}
