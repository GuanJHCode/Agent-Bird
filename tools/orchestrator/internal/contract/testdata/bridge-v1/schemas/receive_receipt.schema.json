{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-bird-bridge-v1/receive_receipt",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "receipt_id": {
      "type": "string"
    },
    "batch_id": {
      "type": "string"
    },
    "attempt_id": {
      "type": "string"
    },
    "render_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "received_at": {
      "type": "string"
    }
  },
  "required": [
    "receipt_id",
    "batch_id",
    "attempt_id",
    "render_sha256",
    "received_at"
  ]
}
