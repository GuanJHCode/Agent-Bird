+			return codeError("provider_lock_changed")
+		}
+		return replacePrivateJSON(req.LockFile, lock)
+	} else if os.IsNotExist(err) {
+		if req.PreviousSHA256 != "" {
+			return codeError("provider_lock_changed")
+		}
+		return writeExclusiveJSON(req.LockFile, lock)
+	} else {
+		return err
+	}
