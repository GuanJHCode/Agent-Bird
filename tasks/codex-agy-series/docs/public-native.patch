diff --git a/tools/orchestrator/internal/adapter/version.go b/tools/orchestrator/internal/adapter/version.go
new file mode 100644
index 00000000..92c96595
--- /dev/null
+++ b/tools/orchestrator/internal/adapter/version.go
@@ -0,0 +1,163 @@
+package adapter
+
+import (
+	"fmt"
+	"regexp"
+	"strconv"
+	"strings"
+)
+
+// parsedVersion is the normalized stable triple used for range checks.
+// The original --version text stays on the binary pin and is never replaced.
+type parsedVersion struct {
+	Major      int
+	Minor      int
+	Patch      int
+	Product    string
+	Prerelease string
+	Build      string
+	Note       string
+	Channel    string
+	Normalized string
+}
+
+var versionLine = regexp.MustCompile(`^(?:(codex-cli|claude-code|claude|grok|agy|antigravity-cli|antigravity)\s+)?v?(\d+)\.(\d+)\.(\d+)(?:-([0-9A-Za-z][0-9A-Za-z.-]*))?(?:\+([0-9A-Za-z.-]+))?(?:\s+\(([^)]+)\))?(?:\s+\[([A-Za-z][0-9A-Za-z.-]*)\])?$`)
+
+func parseCLIVersion(raw string) (parsedVersion, error) {
+	raw = strings.TrimSpace(raw)
+	if raw == "" || len(raw) > 512 || strings.ContainsAny(raw, "\r\n\x00") {
+		return parsedVersion{}, errVersionUnparsed
+	}
+	match := versionLine.FindStringSubmatch(raw)
+	if match == nil {
+		return parsedVersion{}, errVersionUnparsed
+	}
+	major, minor, patch, err := decimalTriple(match[2], match[3], match[4])
+	if err != nil {
+		return parsedVersion{}, err
+	}
+	parsed := parsedVersion{
+		Major: major, Minor: minor, Patch: patch,
+		Product: match[1], Prerelease: match[5], Build: match[6],
+		Note: strings.TrimSpace(match[7]), Channel: strings.ToLower(match[8]),
+		Normalized: fmt.Sprintf("%d.%d.%d", major, minor, patch),
+	}
+	return parsed, nil
+}
+
+func decimalTriple(major, minor, patch string) (int, int, int, error) {
+	values := [3]int{}
+	for i, part := range []string{major, minor, patch} {
+		number, err := strconv.Atoi(part)
+		if err != nil || strconv.Itoa(number) != part {
+			return 0, 0, 0, errVersionUnparsed
+		}
+		values[i] = number
+	}
+	return values[0], values[1], values[2], nil
+}
+
+func (v parsedVersion) compare(other parsedVersion) int {
+	if v.Major != other.Major {
+		return cmpInt(v.Major, other.Major)
+	}
+	if v.Minor != other.Minor {
+		return cmpInt(v.Minor, other.Minor)
+	}
+	return cmpInt(v.Patch, other.Patch)
+}
+
+func cmpInt(left, right int) int {
+	if left < right {
+		return -1
+	}
+	if left > right {
+		return 1
+	}
+	return 0
+}
+
+func releaseClass(provider Provider, v parsedVersion) (string, string) {
+	if v.Prerelease != "" || v.Build != "" || channelWord(v.Channel) || noteHasChannel(v.Note) {
+		return "prerelease", "cli_version_prerelease"
+	}
+	switch v.Channel {
+	case "", "stable", "release", "ga", "latest":
+	default:
+		return "unparsed", "cli_version_unparsed"
+	}
+	switch noteClass(provider, v.Note) {
+	case "prerelease":
+		return "prerelease", "cli_version_prerelease"
+	case "unrecognized":
+		return "unrecognized", "cli_version_unrecognized_note"
+	default:
+		return "stable", ""
+	}
+}
+
+// noteClass allows only the annotations each provider actually prints for a
+// stable build. Any other parenthetical text stays out of the stable window.
+func noteClass(provider Provider, note string) string {
+	if note == "" {
+		return "stable"
+	}
+	if noteHasChannel(note) {
+		return "prerelease"
+	}
+	if knownStableNote(provider, note) {
+		return "stable"
+	}
+	return "unrecognized"
+}
+
+func noteHasChannel(note string) bool {
+	token := note
+	for i, r := range note {
+		if r == ' ' || r == '.' || r == '/' {
+			token = note[:i]
+			break
+		}
+	}
+	return channelWord(token)
+}
+
+func knownStableNote(provider Provider, note string) bool {
+	switch provider {
+	case ProviderClaude:
+		return note == "Claude Code"
+	case ProviderGrok:
+		return grokCommitNote.MatchString(note)
+	default:
+		return false
+	}
+}
+
+var grokCommitNote = regexp.MustCompile(`^[0-9a-fA-F]{7,40}$`)
+
+func channelWord(value string) bool {
+	switch strings.ToLower(strings.TrimSpace(value)) {
+	case "nightly", "dev", "devel", "development", "alpha", "beta", "rc", "pre", "preview", "canary", "insiders", "next":
+		return true
+	default:
+		return false
+	}
+}
+
+func prefixAllowed(provider Provider, product string) bool {
+	if product == "" {
+		return true
+	}
+	switch provider {
+	case ProviderClaude:
+		return product == "claude" || product == "claude-code"
+	case ProviderAGY:
+		return product == "agy" || product == "antigravity" || product == "antigravity-cli"
+	case ProviderGrok:
+		return product == "grok"
+	case ProviderCodex:
+		return product == "codex-cli"
+	default:
+		return false
+	}
+}
diff --git a/tools/orchestrator/internal/host/agy_finished_reason_test.go b/tools/orchestrator/internal/host/agy_finished_reason_test.go
new file mode 100644
index 00000000..f94ff52f
--- /dev/null
+++ b/tools/orchestrator/internal/host/agy_finished_reason_test.go
@@ -0,0 +1,93 @@
+package host
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/GuanJHCode/Agent-Bird/tools/orchestrator/internal/contract"
+)
+
+// The synthetic CLI exits zero and emits progress plus a terminal envelope.
+// Only a complete result may become a result/question or carry a final artifact.
+func TestAGYFinishedReasonCannotPublishPartialResult(t *testing.T) {
+	tests := []struct {
+		name, status, reason, wantStatus, wantEvent, wantText string
+	}{
+		{"normal-success", "SUCCESS", "", "result_ready", contract.EventResult, "FINAL"},
+		{"normal-waiting", "WAITING", "", "waiting_user", contract.EventQuestion, "QUESTION"},
+	}
+	for _, status := range []string{"SUCCESS", "WAITING"} {
+		for _, reason := range []string{"print_timeout", "interrupted", "error"} {
+			tests = append(tests, struct {
+				name, status, reason, wantStatus, wantEvent, wantText string
+			}{status + "-" + reason, status, reason, "failed", contract.EventFailed, ""})
+		}
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			root := t.TempDir()
+			h, err := NewIPC(filepath.Join(root, "spool"), "agy-finished-producer")
+			if err != nil {
+				t.Fatal(err)
+			}
+			text := tc.wantText
+			if tc.reason != "" {
+				text = "PRIVATE_PARTIAL"
+			}
+			terminal := map[string]any{"conversation_id": "agy-finished", "status": tc.status, "response": text}
+			if tc.reason != "" {
+				terminal["finished_reason"] = tc.reason
+			}
+			body, err := json.Marshal(map[string]any{"event": "result", "result": terminal})
+			if err != nil {
+				t.Fatal(err)
+			}
+			stream := "{\"event\":\"init\",\"conversation_id\":\"agy-finished\"}\n" +
+				"{\"event\":\"step_update\",\"step_update\":{\"conversation_id\":\"agy-finished\",\"text_delta\":\"PRIVATE_PARTIAL\"}}\n" + string(body) + "\n"
+			inv := providerInvocation{launchInvocation: launchInvocation{
+				args: []string{"/bin/sh", "-c", `printf '%s' "$1"`, "agy-fixture", stream}, dir: root,
+			}, provider: "antigravity-cli"}
+			grant := contract.LaunchCommand{CommandID: "command", ReservationID: "reservation", RunID: "run", TaskID: "task", AttemptID: "attempt", SegmentID: "segment", WorkRevision: 1, GrantedActiveMS: 3000}
+			result, err := h.ExecuteLaunch(context.Background(), grant, inv)
+			if err != nil || result.ExitCode != 0 || result.Status != tc.wantStatus {
+				t.Fatalf("terminal outcome=%+v err=%v", result, err)
+			}
+			if tc.reason != "" && result.ArtifactPath != "" {
+				t.Fatal("partial result became a final artifact")
+			}
+			sink := &durableSink{}
+			if err := h.PublishAll(context.Background(), sink, 1); err != nil {
+				t.Fatal(err)
+			}
+			found := false
+			for _, event := range sink.events {
+				if tc.reason != "" && (event.Kind == contract.EventResult || event.Kind == contract.EventQuestion) {
+					t.Fatal("incomplete turn became an acceptable result or question")
+				}
+				if event.Kind != tc.wantEvent {
+					continue
+				}
+				found = true
+				if tc.reason != "" {
+					if event.Artifact != nil {
+						t.Fatal("incomplete turn published a partial artifact")
+					}
+				} else {
+					if event.Artifact == nil {
+						t.Fatal("normal turn lost its final artifact")
+					}
+					content, err := os.ReadFile(event.Artifact.Path)
+					if err != nil || string(content) != tc.wantText {
+						t.Fatalf("normal artifact=%q err=%v", content, err)
+					}
+				}
+			}
+			if !found {
+				t.Fatalf("expected durable terminal %s missing", tc.wantEvent)
+			}
+		})
+	}
+}
