diff --git a/tools/orchestrator/internal/adapter/admit.go b/tools/orchestrator/internal/adapter/admit.go
new file mode 100644
index 00000000..985ab69f
--- /dev/null
+++ b/tools/orchestrator/internal/adapter/admit.go
@@ -0,0 +1,173 @@
+package adapter
+
+import "errors"
+import "strings"
+
+var errVersionUnparsed = errors.New("cli_version_unparsed")
+
+// VersionView is the compatibility decision for one raw --version string.
+// Admitted versions still bind path, raw text, and SHA-256 at launch.
+type VersionView struct {
+	Provider   Provider `json:"provider"`
+	Baseline   string   `json:"baseline,omitempty"`
+	Ceiling    string   `json:"ceiling,omitempty"`
+	FrozenAt   string   `json:"frozen_at,omitempty"`
+	Normalized string   `json:"normalized,omitempty"`
+	Protocol   string   `json:"protocol,omitempty"`
+	Admitted   bool     `json:"admitted"`
+	Reason     string   `json:"reason,omitempty"`
+}
+
+// VersionError carries a stable code plus the frozen window.
+// Error() stays the code so existing callers can compare it directly.
+type VersionError struct {
+	Code       string
+	Provider   Provider
+	Raw        string
+	Baseline   string
+	Ceiling    string
+	Normalized string
+}
+
+func (e *VersionError) Error() string {
+	if e == nil {
+		return ""
+	}
+	return e.Code
+}
+
+func AdmitVersion(provider Provider, raw string) error {
+	_, err := assessVersion(provider, raw)
+	return err
+}
+
+func DescribeVersion(provider Provider, raw string) VersionView {
+	view, _ := assessVersion(provider, raw)
+	return view
+}
+
+// TrialBlockedError is the Codex launch gate. Error() stays the stable code.
+// Missing lists the contracts that are still absent, so the gate is not a bare string.
+type TrialBlockedError struct {
+	Missing []string
+}
+
+func (e *TrialBlockedError) Error() string {
+	if e == nil {
+		return ""
+	}
+	return "codex_trial_guard_not_ready"
+}
+
+func CodexTrialBlocked() error {
+	return &TrialBlockedError{Missing: CodexTrialMissing()}
+}
+
+func CodexTrialMissing() []string {
+	return []string{
+		"verified_auth_metadata_source_missing",
+		"exec_refresh_tripwire_not_applied",
+		"native_auth_admission_exact_pin",
+		"codex_exec_collect_loop_not_evidenced",
+	}
+}
+
+// LaunchAdmission decides before any binary read. A nil result means the
+// caller still has to verify the pin, digest, and capabilities.
+// CodexNativePins is deliberately narrower than the frozen version catalog.
+// Additions require native refresh-tripwire, named tool-policy and real
+// read/collect/ACK/accept evidence for the exact binary.
+func CodexNativePins() map[string]string {
+	return map[string]string{
+		"codex-cli 0.154.0": "4f85982624b3898c8991cb80c0981b2aa71070e3537046c9a95950318a95afcc",
+		"codex-cli 0.155.0": "b0b14f9c1901c1ec44671094b2dc18b39e4bd8d36a6dc2302cc9d961a7e2a197",
+		"codex-cli 0.155.1": "8eaf1ad12fe6bf89b1710330f58900014322c7c5af677e43be116d8ac5fc0a9e",
+		"codex-cli 0.156.0": "6b42db4d33fd53516162bd76a0e2d07e0567287c44e036d4e4c06cb555a432f9",
+		"codex-cli 0.156.1": "0196e89fe5a7598f816ee54232c3d7c26d75e502ab5cfe2c9240e81d90f7255a",
+		"codex-cli 0.157.0": "ad0be20d04e2ba6146ecdb51d7f8b7b0fe15420a15dc9b0057518d858f1f3714",
+		"codex-cli 0.157.1": "27ceb5f9b957b43a519efe4eaa3816a0bffb0a531a2c89af18840c0a3c016a7d",
+		"codex-cli 0.158.0": "788a818fbb9596869c7a487554507cb8bdca17584b8671112b23f9e225ba35c8",
+		"codex-cli 0.159.0": "e89718aa1969bfc4a471277bdc4679a3a3529293de0a309909822dfd67ddb77a",
+		"codex-cli 0.159.1": "ab2ed513b0ae735151799ab57045e05ca721c4730859b5aa2f2a9e9bed287eb8",
+		"codex-cli 0.159.2": "16593cc2f422d5f398a8e40f550ebbaf1245392528957be342c295920a300704",
+		"codex-cli 0.159.3": "4d210f7c5a18fd0386434df23b5bdbb8c0e7257d3e8a2b30b0769c8bbe99a878",
+		"codex-cli 0.160.0": "112fae7a5a1223e673c8a1791d32338f37df8b527ff1159bb8adac6c4dbf1b4b",
+		"codex-cli 0.160.1": "09fa44fdc37a5fc70dc1ace31235f90468a2e193d0e85f7552eab068ea2582be",
+		"codex-cli 0.161.0": "12ac11d2c7eee27cfae34393986d7b7c9ed0dea537cb749831cdd7033893e6de",
+		"codex-cli 0.162.0": "8238273076041e55beded03ba1d51e034f997b7d100b0642d36daf036620fe57",
+		"codex-cli 0.162.1": "74c6a6d263f40d65f99c27a815275f5b4ed0bcc2baecc396b4cf3255498bdfc0",
+		"codex-cli 0.163.0": "8813367285524ac798dd96d1b071aea30d58708c7226fd236cd275cf1cfdee31",
+		"codex-cli 0.164.0": "d8990e3ee7acfbc26f91265b12a1a83f0fee40d0e0f8f1f40a37d4ec21f499cf",
+		"codex-cli 0.165.0": "a45099154d7fb4a5ed8a56f40966a95deb938e508bab23e6985035c709e9a85a",
+		"codex-cli 0.166.0": "39acf979729dd290f9a24ee38b2914e036c91b65952872e28ae2a6b88a7db7c1",
+	}
+}
+
+func LaunchAdmission(provider Provider, rawVersion, sha string) error {
+	if provider != ProviderCodex {
+		for raw, digest := range CodexNativePins() {
+			if rawVersion == raw || strings.EqualFold(sha, digest) {
+				return CodexTrialBlocked()
+			}
+		}
+	}
+	if err := AdmitVersion(provider, rawVersion); err != nil {
+		return err
+	}
+	if provider == ProviderCodex {
+		want, ok := CodexNativePins()[rawVersion]
+		if !ok || !strings.EqualFold(sha, want) {
+			return CodexTrialBlocked()
+		}
+	}
+	return nil
+}
+
+func assessVersion(provider Provider, raw string) (VersionView, error) {
+	view := VersionView{Provider: provider}
+	catalog, err := loadCatalog()
+	if err != nil {
+		return rejectVersion(view, "cli_version_catalog_invalid", raw)
+	}
+	policy := catalog.byProvider[provider]
+	if policy == nil {
+		return rejectVersion(view, "cli_version_unparsed", raw)
+	}
+	view.Baseline, view.Ceiling, view.FrozenAt = policy.baselineText, policy.ceilingText, catalog.frozenAt
+	parsed, err := parseCLIVersion(raw)
+	if err != nil {
+		return rejectVersion(view, "cli_version_unparsed", raw)
+	}
+	if !prefixAllowed(provider, parsed.Product) {
+		return rejectVersion(view, "cli_version_product_mismatch", raw)
+	}
+	view.Normalized = parsed.Normalized
+	return classifyReleased(view, policy, parsed, raw)
+}
+
+func classifyReleased(view VersionView, policy *providerPolicy, parsed parsedVersion, raw string) (VersionView, error) {
+	if _, code := releaseClass(view.Provider, parsed); code != "" {
+		return rejectVersion(view, code, raw)
+	}
+	if parsed.compare(policy.baseline) < 0 {
+		return rejectVersion(view, "cli_version_below_baseline", raw)
+	}
+	if parsed.compare(policy.ceiling) > 0 {
+		return rejectVersion(view, "cli_version_above_ceiling", raw)
+	}
+	if _, ok := policy.published[parsed.Normalized]; !ok {
+		return rejectVersion(view, "cli_version_not_published", raw)
+	}
+	view.Admitted = true
+	view.Protocol = policy.protocol
+	return view, nil
+}
+
+func rejectVersion(view VersionView, code, raw string) (VersionView, error) {
+	view.Admitted = false
+	view.Reason = code
+	return view, &VersionError{
+		Code: code, Provider: view.Provider, Raw: raw,
+		Baseline: view.Baseline, Ceiling: view.Ceiling, Normalized: view.Normalized,
+	}
+}
diff --git a/tools/orchestrator/internal/adapter/admit_test.go b/tools/orchestrator/internal/adapter/admit_test.go
new file mode 100644
index 00000000..3e9857f2
--- /dev/null
+++ b/tools/orchestrator/internal/adapter/admit_test.go
@@ -0,0 +1,101 @@
+package adapter
+
+import (
+	"errors"
+	"slices"
+	"strings"
+	"testing"
+)
+
+// The Codex gate is a contract list, not a mood. Closing an item requires
+// real evidence against that contract; until then the full list must come
+// back verbatim, so an implementation cannot graduate by quietly dropping
+// the items it has not satisfied.
+func TestCodexTrialGuardReportsTheFullMissingList(t *testing.T) {
+	want := []string{
+		"verified_auth_metadata_source_missing",
+		"exec_refresh_tripwire_not_applied",
+		"native_auth_admission_exact_pin",
+		"codex_exec_collect_loop_not_evidenced",
+	}
+	if got := CodexTrialMissing(); !slices.Equal(got, want) {
+		t.Fatalf("missing = %v, want the full contract list %v", got, want)
+	}
+	blocked, ok := CodexTrialBlocked().(*TrialBlockedError)
+	if !ok || blocked == nil || blocked.Error() != "codex_trial_guard_not_ready" {
+		t.Fatalf("guard = %#v, want a TrialBlockedError coded codex_trial_guard_not_ready", CodexTrialBlocked())
+	}
+	if !slices.Equal(blocked.Missing, want) {
+		t.Fatalf("blocked missing = %v, want %v", blocked.Missing, want)
+	}
+	// A version catalog entry alone never admits a native identity. Unknown
+	// digests and aliases retain the complete unresolved contract list.
+	for _, admission := range []struct {
+		provider Provider
+		raw, sha string
+	}{
+		{ProviderCodex, CodexVersion, strings.Repeat("0", 64)},
+		{ProviderCodex, "codex-cli 0.166.0", strings.Repeat("a", 64)},
+		{ProviderClaude, CodexVersion, CodexSHA256},
+		{ProviderClaude, "2.1.267 (Claude Code)", CodexSHA256},
+	} {
+		err := LaunchAdmission(admission.provider, admission.raw, admission.sha)
+		var trial *TrialBlockedError
+		if !errors.As(err, &trial) || trial == nil || !slices.Equal(trial.Missing, want) {
+			t.Fatalf("LaunchAdmission(%s, %q) = %v, want the full trial guard", admission.provider, admission.raw, err)
+		}
+	}
+	// Only fully evidenced exact native identities may reach the runtime guard.
+	for raw, sha := range CodexNativePins() {
+		if err := LaunchAdmission(ProviderCodex, raw, sha); err != nil {
+			t.Fatalf("evidenced native pin blocked: %v", err)
+		}
+	}
+
+	// The guard is Codex-scoped: an admitted Claude version still launches.
+	if err := LaunchAdmission(ProviderClaude, "2.1.267 (Claude Code)", strings.Repeat("b", 64)); err != nil {
+		t.Fatalf("admitted Claude version gated: %v", err)
+	}
+}
+
+func TestCodexCatalogRejectionIsSeparateFromUnverifiedNativeGate(t *testing.T) {
+	for _, test := range []struct{ raw, code string }{
+		{"invalid", "cli_version_unparsed"},
+		{"codex-cli 0.153.4", "cli_version_below_baseline"},
+		{"codex-cli 0.167.0", "cli_version_above_ceiling"},
+	} {
+		err := LaunchAdmission(ProviderCodex, test.raw, strings.Repeat("c", 64))
+		var rejected *VersionError
+		if !errors.As(err, &rejected) || rejected.Code != test.code {
+			t.Fatalf("catalog rejection %s: %v", test.raw, err)
+		}
+	}
+	for _, raw := range []string{"codex-cli 0.160.0", "codex-cli 0.166.0"} {
+		err := LaunchAdmission(ProviderCodex, raw, strings.Repeat("c", 64))
+		var blocked *TrialBlockedError
+		if !errors.As(err, &blocked) || !slices.Equal(blocked.Missing, CodexTrialMissing()) {
+			t.Fatalf("unverified native %s: %v", raw, err)
+		}
+	}
+}
+
+func TestCodexNativePinsRetainBaselineEvidenceIdentities(t *testing.T) {
+	pins := CodexNativePins()
+	if len(pins) != 21 || pins[CodexVersion] != CodexSHA256 || pins["codex-cli 0.166.0"] != "39acf979729dd290f9a24ee38b2914e036c91b65952872e28ae2a6b88a7db7c1" {
+		t.Fatal("native pin set changed without evidence")
+	}
+	for raw, digest := range pins {
+		for _, identity := range [][2]string{{raw, ""}, {raw, strings.Repeat("0", 64)}} {
+			var blocked *TrialBlockedError
+			if !errors.As(LaunchAdmission(ProviderCodex, identity[0], identity[1]), &blocked) || !slices.Equal(blocked.Missing, CodexTrialMissing()) {
+				t.Fatal("missing or wrong native digest lost full guard")
+			}
+		}
+		for _, identity := range [][2]string{{raw, strings.Repeat("a", 64)}, {"2.1.267 (Claude Code)", strings.ToUpper(digest)}} {
+			var blocked *TrialBlockedError
+			if !errors.As(LaunchAdmission(ProviderClaude, identity[0], identity[1]), &blocked) {
+				t.Fatal("native identity accepted as another provider")
+			}
+		}
+	}
+}
diff --git a/tools/orchestrator/internal/adapter/agy_finished_reason_test.go b/tools/orchestrator/internal/adapter/agy_finished_reason_test.go
new file mode 100644
index 00000000..05e66211
--- /dev/null
+++ b/tools/orchestrator/internal/adapter/agy_finished_reason_test.go
@@ -0,0 +1,64 @@
+package adapter
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestAGYEarlyTerminationCannotBecomeSuccessOrQuestion(t *testing.T) {
+	for _, status := range []string{"SUCCESS", "WAITING"} {
+		for _, reason := range []string{`"print_timeout"`, `"interrupted"`, `"error"`, `"future"`, `""`, `null`, `7`} {
+			line := `{"event":"result","result":{"conversation_id":"s","status":"` + status + `","response":"PRIVATE_PARTIAL","finished_reason":` + reason + `}}`
+			event, err := ParseEvent(ProviderAGY, line, 4096)
+			if err == nil && (event.Status == "SUCCESS" || event.Kind == EventQuestion || strings.Contains(event.Text, "PRIVATE_PARTIAL")) {
+				t.Fatalf("early result accepted: status=%s reason=%s event=%+v", status, reason, event)
+			}
+		}
+	}
+}
+
+func TestAGYNormalCompletionStillOmitsFinishedReason(t *testing.T) {
+	event, err := ParseEvent(ProviderAGY, `{"event":"result","result":{"conversation_id":"s","status":"SUCCESS","response":"FINAL"}}`, 4096)
+	if err != nil || event.Status != "SUCCESS" || event.Text != "FINAL" || event.Kind != EventResult {
+		t.Fatalf("normal legacy/current result changed: %+v %v", event, err)
+	}
+}
+
+func TestAGYFinishedReasonAlwaysRejectsMalformedOrIncompleteField(t *testing.T) {
+	tests := []struct{ name, reason, want string }{
+		{"timeout", `"print_timeout"`, "event_finished_reason_incomplete"},
+		{"interrupted", `"interrupted"`, "event_finished_reason_incomplete"},
+		{"error", `"error"`, "event_finished_reason_incomplete"},
+		{"unknown", `"future"`, "event_finished_reason_invalid"},
+		{"empty", `""`, "event_finished_reason_invalid"},
+		{"null", `null`, "event_finished_reason_invalid"},
+		{"number", `7`, "event_finished_reason_invalid"},
+		{"boolean", `true`, "event_finished_reason_invalid"},
+		{"array", `[]`, "event_finished_reason_invalid"},
+		{"object", `{}`, "event_finished_reason_invalid"},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			// Invalid field values must be rejected even when status already says ERROR.
+			line := `{"event":"result","result":{"conversation_id":"s","status":"ERROR","response":"PRIVATE_PARTIAL","finished_reason":` + tc.reason + `}}`
+			event, err := ParseEvent(ProviderAGY, line, 4096)
+			if err == nil || err.Error() != tc.want || event.Text != "" || event.Kind != "" {
+				t.Fatalf("reason=%s event=%+v error=%v", tc.name, event, err)
+			}
+		})
+	}
+}
+
+func TestAGYOmittedFinishedReasonPreservesWaitingAndFailure(t *testing.T) {
+	for _, status := range []string{"WAITING", "ERROR"} {
+		line := `{"event":"result","result":{"conversation_id":"s","status":"` + status + `","response":"LEGACY"}}`
+		event, err := ParseEvent(ProviderAGY, line, 4096)
+		kind := EventResult
+		if status == "WAITING" {
+			kind = EventQuestion
+		}
+		if err != nil || event.Status != status || event.Kind != kind || event.Text != "LEGACY" {
+			t.Fatalf("omitted field changed legacy outcome: event=%+v err=%v", event, err)
+		}
+	}
+}
diff --git a/tools/orchestrator/internal/adapter/catalog.go b/tools/orchestrator/internal/adapter/catalog.go
new file mode 100644
index 00000000..33c7decc
--- /dev/null
+++ b/tools/orchestrator/internal/adapter/catalog.go
@@ -0,0 +1,109 @@
+package adapter
+
+import (
+	_ "embed"
+	"encoding/json"
+	"sync"
+)
+
+//go:embed compatibility_catalog.json
+var compatibilityCatalogJSON []byte
+
+// compatibility_catalog.json is the frozen published-stable window.
+// It is not a live "latest" lookup and is not refreshed on each run.
+type catalogFile struct {
+	FrozenAt  string                     `json:"frozen_at"`
+	Providers map[string]catalogProvider `json:"providers"`
+}
+
+type catalogProvider struct {
+	Baseline string           `json:"baseline"`
+	Ceiling  string           `json:"ceiling"`
+	Protocol string           `json:"protocol"`
+	Versions []catalogRelease `json:"versions"`
+}
+
+type catalogRelease struct {
+	Version     string `json:"version"`
+	PublishedAt string `json:"published_at"`
+}
+
+type providerPolicy struct {
+	baseline     parsedVersion
+	ceiling      parsedVersion
+	baselineText string
+	ceilingText  string
+	protocol     string
+	order        []string
+	published    map[string]struct{}
+}
+
+type loadedCatalog struct {
+	frozenAt   string
+	byProvider map[Provider]*providerPolicy
+}
+
+var (
+	catalogOnce   sync.Once
+	catalogLoaded loadedCatalog
+	catalogErr    error
+)
+
+func loadCatalog() (*loadedCatalog, error) {
+	catalogOnce.Do(parseCompatibilityCatalog)
+	if catalogErr != nil {
+		return nil, catalogErr
+	}
+	return &catalogLoaded, nil
+}
+
+func parseCompatibilityCatalog() {
+	var file catalogFile
+	if err := json.Unmarshal(compatibilityCatalogJSON, &file); err != nil {
+		catalogErr = err
+		return
+	}
+	catalogLoaded.frozenAt = file.FrozenAt
+	catalogLoaded.byProvider = map[Provider]*providerPolicy{}
+	for name, spec := range file.Providers {
+		policy, err := newProviderPolicy(spec)
+		if err != nil {
+			catalogErr = err
+			return
+		}
+		catalogLoaded.byProvider[Provider(name)] = policy
+	}
+}
+
+func newProviderPolicy(spec catalogProvider) (*providerPolicy, error) {
+	baseline, err := parseCLIVersion(spec.Baseline)
+	if err != nil {
+		return nil, err
+	}
+	ceiling, err := parseCLIVersion(spec.Ceiling)
+	if err != nil {
+		return nil, err
+	}
+	policy := &providerPolicy{
+		baseline: baseline, ceiling: ceiling,
+		baselineText: spec.Baseline, ceilingText: spec.Ceiling,
+		protocol: spec.Protocol, published: map[string]struct{}{},
+	}
+	for _, release := range spec.Versions {
+		policy.order = append(policy.order, release.Version)
+		policy.published[release.Version] = struct{}{}
+	}
+	return policy, nil
+}
+
+func PublishedVersions(provider Provider) []string {
+	catalog, err := loadCatalog()
+	if err != nil {
+		return nil
+	}
+	policy := catalog.byProvider[provider]
+	if policy == nil {
+		return nil
+	}
+	return append([]string(nil), policy.order...)
+}
diff --git a/tools/orchestrator/internal/adapter/claude_probe.go b/tools/orchestrator/internal/adapter/claude_probe.go
new file mode 100644
index 00000000..302230ac
--- /dev/null
+++ b/tools/orchestrator/internal/adapter/claude_probe.go
@@ -0,0 +1,122 @@
+package adapter
+
+import (
+	"context"
+	"crypto/sha256"
+	"errors"
+	"fmt"
+	"os"
+	"os/exec"
+	"os/user"
+	"path/filepath"
+	"runtime"
+	"strconv"
+	"strings"
+	"syscall"
+	"time"
+)
+
+// Node is an independent executable trust boundary for the legacy JS CLI.
+// This is the official v24.13.0 darwin-arm64 archive's bin/node, not a digest
+// learned from PATH at launch. Additional runtimes need separate acceptance.
+const ClaudeNodeSHA256 = "6f2e835e57feb7a29ffcd53a4d4eb60224ec264a1e002c3ba6d99999ea29807d"
+
+func ClaudeNodePin() (BinaryPin, error) {
+	path := os.Getenv("ORCHESTRATOR_CLAUDE_NODE_BINARY")
+	if path == "" {
+		return BinaryPin{}, errors.New("claude_node_pin_missing")
+	}
+	pin := BinaryPin{Path: path, Version: "v24.13.0", SHA256: ClaudeNodeSHA256}
+	if runtime.GOOS != "darwin" || runtime.GOARCH != "arm64" || VerifyExecutable(pin, pin.Version) != nil {
+		return BinaryPin{}, errors.New("claude_node_runtime_untrusted")
+	}
+	info, err := os.Lstat(path)
+	if err != nil {
+		return BinaryPin{}, errors.New("claude_node_runtime_untrusted")
+	}
+	identity, ok := info.Sys().(*syscall.Stat_t)
+	if !ok || (identity.Uid != uint32(os.Getuid()) && identity.Uid != 0) {
+		return BinaryPin{}, errors.New("claude_node_runtime_untrusted")
+	}
+	return pin, nil
+}
+
+// ProbePinnedOutput keeps non-Claude metadata behavior unchanged. Claude
+// discovery must not execute with a caller credential, config or Node loader.
+func ProbePinnedOutput(ctx context.Context, provider Provider, pin BinaryPin, args ...string) (string, error) {
+	if provider != ProviderClaude {
+		return ProbeOutput(ctx, pin.Path, args...)
+	}
+	window := 2 * time.Second
+	if strings.HasSuffix(pin.Path, ".js") {
+		// Copying and starting the pinned Node bundle under Seatbelt is slower
+		// than native metadata. Keep a separate bounded legacy probe window.
+		window = 8 * time.Second
+	}
+	ctx, cancel := context.WithTimeout(ctx, window)
+	defer cancel()
+	if err := VerifyExecutable(pin, pin.Version); err != nil {
+		return "", err
+	}
+	if runtime.GOOS != "darwin" {
+		return "", errors.New("claude_probe_sandbox_unsupported")
+	}
+	home, err := os.MkdirTemp("", "claude-probe-")
+	if err != nil {
+		return "", err
+	}
+	defer os.RemoveAll(home)
+	home, err = filepath.EvalSymlinks(home)
+	if err != nil {
+		return "", err
+	}
+	account, err := user.Current()
+	if err != nil {
+		return "", errors.New("claude_probe_source_unverified")
+	}
+	path, argv := pin.Path, append([]string{}, args...)
+	rules := []string{"(version 1)", "(allow default)", "(deny network*)", "(deny file-write*)", `(allow file-write* (literal "/dev/null"))`, "(allow file-read* file-write* (subpath " + strconv.Quote(home) + "))"}
+	for _, raw := range []string{account.HomeDir, os.Getenv("HOME"), os.Getenv("CLAUDE_CONFIG_DIR"), os.Getenv("CLAUDE_SECURESTORAGE_CONFIG_DIR")} {
+		if raw == "" {
+			continue
+		}
+		root, err := filepath.EvalSymlinks(raw)
+		if err != nil || !filepath.IsAbs(raw) || root == "/" {
+			return "", errors.New("claude_probe_source_unverified")
+		}
+		rules = append(rules, "(deny file-read* (subpath "+strconv.Quote(root)+"))")
+	}
+	rules = append(rules, "(allow file-read* (literal "+strconv.Quote(pin.Path)+"))")
+	if strings.HasSuffix(pin.Path, ".js") {
+		node, err := ClaudeNodePin()
+		if err != nil {
+			return "", err
+		}
+		path, argv = node.Path, append([]string{pin.Path}, args...)
+		// A Node executable located under the denied caller home cannot safely
+		// initialize there on macOS. Use the same official bytes in private state.
+		body, err := os.ReadFile(node.Path)
+		if err != nil || fmt.Sprintf("%x", sha256.Sum256(body)) != ClaudeNodeSHA256 {
+			return "", errors.New("claude_node_runtime_untrusted")
+		}
+		path = filepath.Join(home, "node")
+		if err := os.WriteFile(path, body, 0700); err != nil {
+			return "", err
+		}
+	}
+	for _, service := range []string{"com.apple.SecurityServer", "com.apple.securityd", "com.apple.securityd.system", "com.apple.securityd.systemkeychain"} {
+		rules = append(rules, "(deny mach-lookup (global-name "+strconv.Quote(service)+"))")
+	}
+	argv = append([]string{"-p", strings.Join(rules, "\n"), path}, argv...)
+	cmd := exec.CommandContext(ctx, "/usr/bin/sandbox-exec", argv...)
+	cmd.Dir = home
+	cmd.Env = []string{"PATH=/usr/bin:/bin:/usr/sbin:/sbin", "LANG=en_US.UTF-8", "HOME=" + home, "TMPDIR=" + home, "CLAUDE_CONFIG_DIR=" + home, "CLAUDE_SECURESTORAGE_CONFIG_DIR=" + home, "DISABLE_AUTOUPDATER=1", "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1"}
+	output, err := probeCommandOutput(ctx, cmd, args...)
+	if err != nil {
+		return "", err
+	}
+	if err := VerifyExecutable(pin, pin.Version); err != nil {
+		return "", err
+	}
+	return output, nil
+}
diff --git a/tools/orchestrator/internal/adapter/claude_probe_test.go b/tools/orchestrator/internal/adapter/claude_probe_test.go
new file mode 100644
index 00000000..29c91568
--- /dev/null
+++ b/tools/orchestrator/internal/adapter/claude_probe_test.go
@@ -0,0 +1,61 @@
+package adapter
+
+import (
+	"context"
+	"crypto/sha256"
+	"fmt"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestClaudeProbeUsesPrivateStateAndCannotTouchCallerHome(t *testing.T) {
+	home, err := filepath.EvalSymlinks(t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("HOME", home)
+	t.Setenv("CLAUDE_CONFIG_DIR", home)
+	for _, name := range []string{"ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN", "CLAUDE_CODE_OAUTH_TOKEN", "NODE_OPTIONS", "HTTPS_PROXY", "DYLD_INSERT_LIBRARIES"} {
+		t.Setenv(name, "SYNTHETIC_UNTRUSTED")
+	}
+	secret := filepath.Join(home, "source-auth")
+	if err := os.WriteFile(secret, []byte("SYNTHETIC_AUTH"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	body, err := os.ReadFile("/bin/sh")
+	if err != nil {
+		t.Fatal(err)
+	}
+	pin := BinaryPin{Path: "/bin/sh", Version: "probe", SHA256: fmt.Sprintf("%x", sha256.Sum256(body))}
+	script := `test "$HOME" != "$1" && test "$CLAUDE_CONFIG_DIR" = "$HOME" && test "$DISABLE_AUTOUPDATER" = 1 && test -z "${ANTHROPIC_API_KEY+x}${ANTHROPIC_AUTH_TOKEN+x}${CLAUDE_CODE_OAUTH_TOKEN+x}${NODE_OPTIONS+x}${HTTPS_PROXY+x}${DYLD_INSERT_LIBRARIES+x}" && test ! -r "$1/source-auth" && ! touch "$1/probe-write" 2>/dev/null && printf '%s' "$2"`
+	for _, flag := range []string{"--version", "--help"} {
+		output, err := ProbePinnedOutput(context.Background(), ProviderClaude, pin, "-c", script, "probe", home, flag)
+		if err != nil || output != flag {
+			t.Fatalf("unsafe %s probe: %q %v", flag, output, err)
+		}
+	}
+	if got, err := os.ReadFile(secret); err != nil || string(got) != "SYNTHETIC_AUTH" {
+		t.Fatal("source changed")
+	}
+}
+
+func TestClaudeNodeRequiresExplicitOfficialPinBeforeExecution(t *testing.T) {
+	root, err := filepath.EvalSymlinks(t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	fake := filepath.Join(root, "node")
+	if err := os.WriteFile(fake, []byte("#!/bin/sh\nexit 0\n"), 0700); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("PATH", root+":/usr/bin:/bin")
+	t.Setenv("ORCHESTRATOR_CLAUDE_NODE_BINARY", "")
+	if _, err := ClaudeNodePin(); err == nil || err.Error() != "claude_node_pin_missing" {
+		t.Fatal("ambient PATH selected Node")
+	}
+	t.Setenv("ORCHESTRATOR_CLAUDE_NODE_BINARY", fake)
+	if _, err := ClaudeNodePin(); err == nil || err.Error() != "claude_node_runtime_untrusted" {
+		t.Fatal("fake Node accepted")
+	}
+}
