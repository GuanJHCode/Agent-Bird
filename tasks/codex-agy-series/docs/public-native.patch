+func TestCodexCleanupNeverFollowsReplacementHome(t *testing.T) {
+	root := t.TempDir()
+	scratch := filepath.Join(root, "scratch")
+	outside := filepath.Join(root, "outside")
+	if err := os.MkdirAll(scratch, 0700); err != nil {
