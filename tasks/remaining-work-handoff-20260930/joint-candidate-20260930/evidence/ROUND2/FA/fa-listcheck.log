### -run 正则命中集证明 (go test -list, 不执行)
--- -run 'TestProgressStays' 命中:
    TestProgressStaysBoundedWhileDescendantHoldsPipeAndNeverFinalizes
    count=1
--- -run 'TestN04PipeSensitive' 命中:
    TestN04PipeSensitiveDescendantHoldingStdoutIsNecessary
    count=1
--- -run 'TestProgressStays|TestN04PipeSensitive' 命中:
    TestN04PipeSensitiveDescendantHoldingStdoutIsNecessary
    TestProgressStaysBoundedWhileDescendantHoldsPipeAndNeverFinalizes
    count=2
--- -run 'Descendant' 命中:
    TestN04PipeSensitiveDescendantHoldingStdoutIsNecessary
    TestPipeHoldingDescendantRecordsSingleStoppingProgress
    TestDescendantHoldingPipesSameGroupNeverReportsResult
    TestEscapedDescendantHoldingPipesCannotProduceResult
    TestProgressStaysBoundedWhileDescendantHoldsPipeAndNeverFinalizes
    count=5
--- -run 'Holder' 命中:
    TestEscapedPipeHolderProgressDoesNotAdvanceAfterTerminal
    count=1
--- -run '^(TestProgressStaysBoundedWhileDescendantHoldsPipeAndNeverFinalizes|TestN04PipeSensitiveDescendantHoldingStdoutIsNecessary)$' 命中:
    TestN04PipeSensitiveDescendantHoldingStdoutIsNecessary
    TestProgressStaysBoundedWhileDescendantHoldsPipeAndNeverFinalizes
    count=2

