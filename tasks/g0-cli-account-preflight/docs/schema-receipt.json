            },
            "description": "Multi-bucket view keyed by metered `limit_id` (for example, `codex`).",
            "type": [
              "object",
              "null"
            ]
          }
        },
        "required": [
          "rateLimits"
        ],
        "title": "GetAccountRateLimitsResponse",
        "type": "object"
      }
