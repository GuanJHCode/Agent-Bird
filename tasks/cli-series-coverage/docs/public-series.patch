+package adapter
+
+import "errors"
+import "strings"
+
+var errVersionUnparsed = errors.New("cli_version_unparsed")
+
+// VersionView is the compatibility decision for one raw --version string.
+// Admitted versions still bind path, raw text, and SHA-256 at launch.
+type VersionView struct {
+	Provider   Provider `json:"provider"`
+	Baseline   string   `json:"baseline,omitempty"`
+	Ceiling    string   `json:"ceiling,omitempty"`
+	FrozenAt   string   `json:"frozen_at,omitempty"`
+	Normalized string   `json:"normalized,omitempty"`
+	Protocol   string   `json:"protocol,omitempty"`
+	Admitted   bool     `json:"admitted"`
+	Reason     string   `json:"reason,omitempty"`
+}
+
+// VersionError carries a stable code plus the frozen window.
+// Error() stays the code so existing callers can compare it directly.
+type VersionError struct {
+	Code       string
+	Provider   Provider
+	Raw        string
+	Baseline   string
+	Ceiling    string
+	Normalized string
+}
+
+func (e *VersionError) Error() string {
+	if e == nil {
+		return ""
+	}
+	return e.Code
+}
+
+func AdmitVersion(provider Provider, raw string) error {
+	_, err := assessVersion(provider, raw)
+	return err
+}
+
+func DescribeVersion(provider Provider, raw string) VersionView {
+	view, _ := assessVersion(provider, raw)
+	return view
+}
+
+// TrialBlockedError is the Codex launch gate. Error() stays the stable code.
+// Missing lists the contracts that are still absent, so the gate is not a bare string.
+type TrialBlockedError struct {
+	Missing []string
+}
+
+func (e *TrialBlockedError) Error() string {
+	if e == nil {
+		return ""
+	}
+	return "codex_trial_guard_not_ready"
+}
+
+func CodexTrialBlocked() error {
+	return &TrialBlockedError{Missing: CodexTrialMissing()}
+}
+
+func CodexTrialMissing() []string {
+	return []string{
+		"verified_auth_metadata_source_missing",
+		"exec_refresh_tripwire_not_applied",
+		"native_auth_admission_pinned_0.154.0",
+		"codex_exec_collect_loop_not_evidenced",
+	}
+}
+
+// LaunchAdmission decides before any binary read. A nil result means the
+// caller still has to verify the pin, digest, and capabilities.
+func LaunchAdmission(provider Provider, rawVersion, sha string) error {
+	if provider == ProviderCodex || rawVersion == CodexVersion || strings.EqualFold(sha, CodexSHA256) {
+		return CodexTrialBlocked()
+	}
+	if err := AdmitVersion(provider, rawVersion); err != nil {
+		return err
+	}
+	return nil
+}
+
+func assessVersion(provider Provider, raw string) (VersionView, error) {
+	view := VersionView{Provider: provider}
+	catalog, err := loadCatalog()
+	if err != nil {
+		return rejectVersion(view, "cli_version_catalog_invalid", raw)
+	}
+	policy := catalog.byProvider[provider]
+	if policy == nil {
+		return rejectVersion(view, "cli_version_unparsed", raw)
+	}
+	view.Baseline, view.Ceiling, view.FrozenAt = policy.baselineText, policy.ceilingText, catalog.frozenAt
+	parsed, err := parseCLIVersion(raw)
+	if err != nil {
+		return rejectVersion(view, "cli_version_unparsed", raw)
+	}
+	if !prefixAllowed(provider, parsed.Product) {
+		return rejectVersion(view, "cli_version_product_mismatch", raw)
+	}
+	view.Normalized = parsed.Normalized
+	return classifyReleased(view, policy, parsed, raw)
+}
+
+func classifyReleased(view VersionView, policy *providerPolicy, parsed parsedVersion, raw string) (VersionView, error) {
+	if _, code := releaseClass(view.Provider, parsed); code != "" {
+		return rejectVersion(view, code, raw)
+	}
+	if parsed.compare(policy.baseline) < 0 {
+		return rejectVersion(view, "cli_version_below_baseline", raw)
+	}
+	if parsed.compare(policy.ceiling) > 0 {
+		return rejectVersion(view, "cli_version_above_ceiling", raw)
+	}
+	if _, ok := policy.published[parsed.Normalized]; !ok {
+		return rejectVersion(view, "cli_version_not_published", raw)
+	}
+	view.Admitted = true
+	view.Protocol = policy.protocol
+	return view, nil
+}
+
+func rejectVersion(view VersionView, code, raw string) (VersionView, error) {
+	view.Admitted = false
+	view.Reason = code
+	return view, &VersionError{
+		Code: code, Provider: view.Provider, Raw: raw,
+		Baseline: view.Baseline, Ceiling: view.Ceiling, Normalized: view.Normalized,
+	}
+}
diff --git a/tools/orchestrator/internal/adapter/admit_test.go b/tools/orchestrator/internal/adapter/admit_test.go
new file mode 100644
index 00000000..190c96e5
--- /dev/null
+++ b/tools/orchestrator/internal/adapter/admit_test.go
@@ -0,0 +1,53 @@
+package adapter
+
+import (
+	"errors"
+	"slices"
+	"strings"
+	"testing"
+)
+
+// The Codex gate is a contract list, not a mood. Closing an item requires
+// real evidence against that contract; until then the full list must come
+// back verbatim, so an implementation cannot graduate by quietly dropping
+// the items it has not satisfied.
+func TestCodexTrialGuardReportsTheFullMissingList(t *testing.T) {
+	want := []string{
+		"verified_auth_metadata_source_missing",
+		"exec_refresh_tripwire_not_applied",
+		"native_auth_admission_pinned_0.154.0",
+		"codex_exec_collect_loop_not_evidenced",
+	}
+	if got := CodexTrialMissing(); !slices.Equal(got, want) {
+		t.Fatalf("missing = %v, want the full contract list %v", got, want)
+	}
+	blocked, ok := CodexTrialBlocked().(*TrialBlockedError)
+	if !ok || blocked == nil || blocked.Error() != "codex_trial_guard_not_ready" {
+		t.Fatalf("guard = %#v, want a TrialBlockedError coded codex_trial_guard_not_ready", CodexTrialBlocked())
+	}
+	if !slices.Equal(blocked.Missing, want) {
+		t.Fatalf("blocked missing = %v, want %v", blocked.Missing, want)
+	}
+	// Every Codex launch is gated, across the whole admitted window: neither
+	// the pinned baseline nor a later admitted version slips past, and the
+	// historical pin cannot alias a different provider past the gate either.
+	for _, admission := range []struct {
+		provider Provider
+		raw, sha string
+	}{
+		{ProviderCodex, CodexVersion, CodexSHA256},
+		{ProviderCodex, "codex-cli 0.166.0", strings.Repeat("a", 64)},
+		{ProviderClaude, CodexVersion, CodexSHA256},
+		{ProviderClaude, "2.1.267 (Claude Code)", CodexSHA256},
+	} {
+		err := LaunchAdmission(admission.provider, admission.raw, admission.sha)
+		var trial *TrialBlockedError
+		if !errors.As(err, &trial) || trial == nil || !slices.Equal(trial.Missing, want) {
+			t.Fatalf("LaunchAdmission(%s, %q) = %v, want the full trial guard", admission.provider, admission.raw, err)
+		}
+	}
+	// The guard is Codex-scoped: an admitted Claude version still launches.
+	if err := LaunchAdmission(ProviderClaude, "2.1.267 (Claude Code)", strings.Repeat("b", 64)); err != nil {
+		t.Fatalf("admitted Claude version gated: %v", err)
+	}
+}
diff --git a/tools/orchestrator/internal/adapter/catalog.go b/tools/orchestrator/internal/adapter/catalog.go
new file mode 100644
index 00000000..33c7decc
--- /dev/null
+++ b/tools/orchestrator/internal/adapter/catalog.go
@@ -0,0 +1,109 @@
+package adapter
+
+import (
+	_ "embed"
+	"encoding/json"
+	"sync"
+)
+
+//go:embed compatibility_catalog.json
+var compatibilityCatalogJSON []byte
+
+// compatibility_catalog.json is the frozen published-stable window.
+// It is not a live "latest" lookup and is not refreshed on each run.
+type catalogFile struct {
+	FrozenAt  string                     `json:"frozen_at"`
+	Providers map[string]catalogProvider `json:"providers"`
+}
+
+type catalogProvider struct {
+	Baseline string           `json:"baseline"`
+	Ceiling  string           `json:"ceiling"`
+	Protocol string           `json:"protocol"`
+	Versions []catalogRelease `json:"versions"`
+}
+
+type catalogRelease struct {
+	Version     string `json:"version"`
+	PublishedAt string `json:"published_at"`
+}
+
+type providerPolicy struct {
+	baseline     parsedVersion
+	ceiling      parsedVersion
+	baselineText string
+	ceilingText  string
+	protocol     string
+	order        []string
+	published    map[string]struct{}
+}
+
+type loadedCatalog struct {
+	frozenAt   string
+	byProvider map[Provider]*providerPolicy
+}
+
+var (
+	catalogOnce   sync.Once
+	catalogLoaded loadedCatalog
+	catalogErr    error
+)
+
+func loadCatalog() (*loadedCatalog, error) {
+	catalogOnce.Do(parseCompatibilityCatalog)
+	if catalogErr != nil {
+		return nil, catalogErr
+	}
+	return &catalogLoaded, nil
+}
+
+func parseCompatibilityCatalog() {
+	var file catalogFile
+	if err := json.Unmarshal(compatibilityCatalogJSON, &file); err != nil {
+		catalogErr = err
+		return
+	}
+	catalogLoaded.frozenAt = file.FrozenAt
+	catalogLoaded.byProvider = map[Provider]*providerPolicy{}
+	for name, spec := range file.Providers {
+		policy, err := newProviderPolicy(spec)
+		if err != nil {
+			catalogErr = err
+			return
+		}
+		catalogLoaded.byProvider[Provider(name)] = policy
+	}
+}
+
+func newProviderPolicy(spec catalogProvider) (*providerPolicy, error) {
+	baseline, err := parseCLIVersion(spec.Baseline)
+	if err != nil {
+		return nil, err
+	}
+	ceiling, err := parseCLIVersion(spec.Ceiling)
+	if err != nil {
+		return nil, err
+	}
+	policy := &providerPolicy{
+		baseline: baseline, ceiling: ceiling,
+		baselineText: spec.Baseline, ceilingText: spec.Ceiling,
+		protocol: spec.Protocol, published: map[string]struct{}{},
+	}
+	for _, release := range spec.Versions {
+		policy.order = append(policy.order, release.Version)
+		policy.published[release.Version] = struct{}{}
+	}
+	return policy, nil
+}
+
+func PublishedVersions(provider Provider) []string {
+	catalog, err := loadCatalog()
+	if err != nil {
+		return nil
+	}
+	policy := catalog.byProvider[provider]
+	if policy == nil {
+		return nil
+	}
+	return append([]string(nil), policy.order...)
+}
