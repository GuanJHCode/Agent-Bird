+	rules := []string{}
+	for _, root := range denied {
+		rules = append(rules, "(deny file-read* (subpath "+strconv.Quote(root)+"))")
+	}
+	// Current Claude vets every settings path component. Permit metadata for
+	// this launch's scratch ancestors; sibling spool contents remain unreadable.
+	for parent := filepath.Dir(scratch); ; parent = filepath.Dir(parent) {
+		rules = append(rules, "(allow file-read-metadata (literal "+strconv.Quote(parent)+"))")
+		if filepath.Base(parent) == "host-spool" || parent == filepath.Dir(parent) {
+			break
+		}
+	}
+	rules = append(rules, "(deny file-write* (subpath "+strconv.Quote(policy)+"))")
+	rules = append(rules, "(allow file-read* (subpath "+strconv.Quote(cmd.Dir)+"))", "(allow file-read* (literal "+strconv.Quote(cmd.Path)+"))")
+	if interpreter != "" {
+		rules = append(rules, "(allow file-read* (literal "+strconv.Quote(interpreter)+"))")
+		rules = append(rules, "(deny file-write* (subpath "+strconv.Quote(filepath.Dir(interpreter))+"))")
+	}
+	for _, root := range homes {
+		for _, name := range []string{".claude", ".claude.json", "Library/Keychains"} {
+			projectPaths = append(projectPaths, filepath.Join(root, name))
+		}
+	}
+	for _, path := range projectPaths {
+		rules = append(rules, "(deny file-read* (subpath "+strconv.Quote(path)+"))")
+	}
+	for _, path := range []string{"/Library/Application Support/ClaudeCode", "/etc/claude-code", "/Library/Managed Preferences/com.anthropic.claudecode.plist", "/Library/Managed Preferences/com.anthropic.ClaudeCode.plist"} {
+		rules = append(rules, "(deny file-read* (subpath "+strconv.Quote(path)+"))")
+	}
+	for _, name := range []string{"com.apple.SecurityServer", "com.apple.securityd", "com.apple.securityd.system", "com.apple.securityd.systemkeychain"} {
+		rules = append(rules, "(deny mach-lookup (global-name "+strconv.Quote(name)+"))")
+	}
+	prepared.Args[1] += "\n" + strings.Join(rules, "\n")
+	for path, body := range map[string]string{mcp: `{"mcpServers":{}}`, settings: `{}`} {
+		before, err := os.Lstat(path)
+		if err != nil || !before.Mode().IsRegular() || before.Mode().Perm() != 0600 {
+			return cmd, errors.New("claude_gateway_config_untrusted")
+		}
+		identity, ok := before.Sys().(*syscall.Stat_t)
+		observed, readErr := os.ReadFile(path)
+		after, statErr := os.Lstat(path)
+		if !ok || identity.Uid != uint32(os.Getuid()) || identity.Nlink != 1 || readErr != nil || statErr != nil || !os.SameFile(before, after) || string(observed) != body {
+			return cmd, errors.New("claude_gateway_config_untrusted")
+		}
+	}
+	return prepared, nil
+}
+
+func cleanupClaudeGatewayState(scratch string) {
+	// RemoveAll does not follow a replacement symlink. Only this launch's fresh
+	// child state is removed; caller auth/config paths are never cleanup inputs.
+	_ = os.RemoveAll(filepath.Join(scratch, "claude-home"))
+}
+
+func checkClaudeManagedSources(ctx context.Context) error {
+	for _, path := range []string{"/Library/Application Support/ClaudeCode/managed-settings.json", "/Library/Application Support/ClaudeCode/managed-mcp.json", "/Library/Application Support/ClaudeCode/managed-settings.d", "/etc/claude-code/managed-settings.json", "/etc/claude-code/managed-mcp.json", "/Library/Managed Preferences/com.anthropic.claudecode.plist", "/Library/Managed Preferences/com.anthropic.ClaudeCode.plist"} {
+		if _, err := os.Lstat(path); !os.IsNotExist(err) {
+			return errors.New("claude_gateway_managed_config_unverified")
+		}
+	}
+	for _, domain := range []string{"com.anthropic.claudecode", "com.anthropic.ClaudeCode"} {
+		probeCtx, cancel := context.WithTimeout(ctx, 2*time.Second)
+		command := exec.CommandContext(probeCtx, "/usr/bin/defaults", "read", domain)
+		command.Env = []string{"PATH=/usr/bin:/bin", "LANG=en_US.UTF-8"}
+		output, err := command.CombinedOutput()
+		cancel()
+		if err == nil || !strings.Contains(string(output), "does not exist") {
+			return errors.New("claude_gateway_managed_config_unverified")
+		}
+	}
+	return nil
+}
diff --git a/tools/orchestrator/internal/host/claude_native_test.go b/tools/orchestrator/internal/host/claude_native_test.go
new file mode 100644
index 00000000..9a42669e
--- /dev/null
+++ b/tools/orchestrator/internal/host/claude_native_test.go
@@ -0,0 +1,210 @@
+package host
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"github.com/GuanJHCode/Agent-Bird/tools/orchestrator/internal/adapter"
+	"github.com/GuanJHCode/Agent-Bird/tools/orchestrator/internal/process"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"os/user"
+	"path/filepath"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+// TestNativeClaudeGatewayReadOnlyTransport launches a fixed CLI against an owned
+// loopback SSE fixture; it uses no real credential and spends no model credits.
+// This is transport/tool evidence, not a real-model acceptance result.
+func TestNativeClaudeGatewayReadOnlyTransport(t *testing.T) {
+	binary := os.Getenv("ORCHESTRATOR_CLAUDE_NATIVE_BINARY")
+	if binary == "" {
+		t.Skip("requires explicit fixed native/Node CLI path; no model or real credential")
+	}
+	cmd, profile, scratch, source := claudeGatewayFixture(t)
+	account, err := user.Current()
+	if err != nil {
+		t.Fatal(err)
+	}
+	source.homes = append(source.homes, account.HomeDir)
+	cmd.Path = binary
+	scratch = filepath.Join(scratch, "state", "host-spool", "launch", "attempt", "segment", "scratch")
+	const sentinel = "SYNTHETIC_READ_SENTINEL"
+	readPath := filepath.Join(cmd.Dir, "INPUT.txt")
+	if err := os.WriteFile(readPath, []byte(sentinel), 0600); err != nil {
+		t.Fatal(err)
+	}
+	discovery, err := adapter.Probe(context.Background(), adapter.ProviderClaude, binary)
+	if err != nil {
+		t.Fatal(err)
+	}
+	source.help, err = adapter.ProbePinnedOutput(context.Background(), adapter.ProviderClaude, discovery.Binary, "--help")
+	if err != nil {
+		t.Fatal(err)
+	}
+	apiKey := os.Getenv("ORCHESTRATOR_CLAUDE_NATIVE_AUTH") == "api-key"
+	if apiKey {
+		source.env["ANTHROPIC_API_KEY"] = source.env["ANTHROPIC_AUTH_TOKEN"]
+		delete(source.env, "ANTHROPIC_AUTH_TOKEN")
+	}
+	credential := source.env["ANTHROPIC_AUTH_TOKEN"] + source.env["ANTHROPIC_API_KEY"]
+	var requests, reads atomic.Int32
+	{
+		server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			if r.Method != http.MethodPost || !strings.HasSuffix(r.URL.Path, "/messages") {
+				http.NotFound(w, r)
+				return
+			}
+			wantAuth, wantKey := "Bearer "+credential, ""
+			if apiKey {
+				wantAuth, wantKey = "", credential
+			}
+			if r.Header.Get("Authorization") != wantAuth || r.Header.Get("X-Api-Key") != wantKey {
+				t.Error("gateway credential header mismatch")
+			}
+			body, err := io.ReadAll(io.LimitReader(r.Body, 2<<20))
+			var request struct {
+				Model  string `json:"model"`
+				Stream bool   `json:"stream"`
+				Tools  []struct {
+					Name string `json:"name"`
+				} `json:"tools"`
+				Messages []struct {
+					Content json.RawMessage `json:"content"`
+				} `json:"messages"`
+			}
+			if err != nil || json.Unmarshal(body, &request) != nil || request.Model != string(profile.Model) {
+				t.Error("invalid synthetic model request")
+				http.Error(w, "invalid request", 400)
+				return
+			}
+			hasRead := false
+			for _, tool := range request.Tools {
+				hasRead = hasRead || tool.Name == "Read"
+				if strings.HasPrefix(tool.Name, "mcp__") || tool.Name == "Bash" || tool.Name == "Edit" || tool.Name == "MultiEdit" || tool.Name == "Write" || tool.Name == "NotebookEdit" || tool.Name == "Agent" || tool.Name == "Task" || tool.Name == "WebFetch" || tool.Name == "WebSearch" {
+					t.Errorf("forbidden tool advertised: %s", tool.Name)
+				}
+			}
+
+			readSeen := false
+			for _, message := range request.Messages {
+				var blocks []struct {
+					Type      string          `json:"type"`
+					ToolUseID string          `json:"tool_use_id"`
+					Content   json.RawMessage `json:"content"`
+				}
+				if json.Unmarshal(message.Content, &blocks) == nil {
+					for _, block := range blocks {
+						if block.Type == "tool_result" && block.ToolUseID == "read_fixture" && strings.Contains(string(block.Content), sentinel) {
+							readSeen = true
+						}
+					}
+				}
+			}
+			requests.Add(1)
+			if !request.Stream {
+				content := []any{map[string]any{"type": "text", "text": "GATEWAY_FIXTURE"}}
+				stopReason := "end_turn"
+				if hasRead && !readSeen {
+					stopReason = "tool_use"
+					content = []any{map[string]any{"type": "tool_use", "id": "read_fixture", "name": "Read", "input": map[string]string{"file_path": readPath}}}
+				}
+				if readSeen {
+					reads.Add(1)
+				}
+				w.Header().Set("Content-Type", "application/json")
+				_ = json.NewEncoder(w).Encode(map[string]any{"id": "msg_fixture", "type": "message", "role": "assistant", "model": request.Model, "content": content, "stop_reason": stopReason, "stop_sequence": nil, "usage": map[string]int{"input_tokens": 1, "output_tokens": 1}})
+				return
+			}
+			w.Header().Set("Content-Type", "text/event-stream")
+			write := func(kind string, data any) {
+				b, _ := json.Marshal(data)
+				fmt.Fprintf(w, "event: %s\ndata: %s\n\n", kind, b)
+			}
+			write("message_start", map[string]any{"type": "message_start", "message": map[string]any{"id": "msg_fixture", "type": "message", "role": "assistant", "model": "deepseek-v4.1-flash-1017", "content": []any{}, "stop_reason": nil, "stop_sequence": nil, "usage": map[string]int{"input_tokens": 1, "output_tokens": 0}}})
+			stopReason := "tool_use"
+			if readSeen || !hasRead {
+				if readSeen {
+					reads.Add(1)
+				}
+				stopReason = "end_turn"
+				write("content_block_start", map[string]any{"type": "content_block_start", "index": 0, "content_block": map[string]string{"type": "text", "text": ""}})
+				write("content_block_delta", map[string]any{"type": "content_block_delta", "index": 0, "delta": map[string]string{"type": "text_delta", "text": "GATEWAY_FIXTURE"}})
+			} else {
+				write("content_block_start", map[string]any{"type": "content_block_start", "index": 0, "content_block": map[string]any{"type": "tool_use", "id": "read_fixture", "name": "Read", "input": map[string]any{}}})
+				input, _ := json.Marshal(map[string]string{"file_path": readPath})
+				write("content_block_delta", map[string]any{"type": "content_block_delta", "index": 0, "delta": map[string]string{"type": "input_json_delta", "partial_json": string(input)}})
+			}
+			write("content_block_stop", map[string]any{"type": "content_block_stop", "index": 0})
+			write("message_delta", map[string]any{"type": "message_delta", "delta": map[string]any{"stop_reason": stopReason, "stop_sequence": nil}, "usage": map[string]int{"output_tokens": 1}})
+			write("message_stop", map[string]string{"type": "message_stop"})
+		}))
+		defer server.Close()
+		source.env["ANTHROPIC_BASE_URL"] = server.URL
+		profile.Model = "deepseek-v4.1-flash-1017"
+		lock, err := adapter.Probe(context.Background(), adapter.ProviderClaude, binary)
+		if err != nil {
+			t.Fatal(err)
+		}
+		inv, err := adapter.BuildInvocation(adapter.Request{Provider: adapter.ProviderClaude, Binary: lock.Binary, Lock: &lock, Profile: profile, CWD: cmd.Dir, Prompt: "Read INPUT.txt and reply GATEWAY_FIXTURE"})
+		if err != nil {
+			t.Fatal(err)
+		}
+		cmd.Args = inv.Args()[1:]
+		cmd.Stdin = inv.Stdin()
+	}
+
+	prepared, err := prepareClaudeGateway(context.Background(), cmd, profile, scratch, source)
+	if err != nil {
+		t.Fatal(err)
+	}
+	h, err := process.Start(context.Background(), prepared)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Second)
+	defer cancel()
+	err = h.Wait(ctx)
+	if err != nil {
+		stop, done := context.WithTimeout(context.Background(), 5*time.Second)
+		defer done()
+		_ = h.Stop(stop)
+	}
+	if h.ExitCode() != 0 {
+		t.Logf("exit=%d output=%q", h.ExitCode(), h.Output())
+	} else {
+		t.Logf("exit=0 captured_bytes=%d gateway_requests=%d read_results=%d", len(h.Output()), requests.Load(), reads.Load())
+	}
+	if requests.Load() < 2 || reads.Load() == 0 || !strings.Contains(h.Output(), "GATEWAY_FIXTURE") {
+		t.Error("synthetic header/SSE/Read transport incomplete")
+	}
+	_ = filepath.WalkDir(scratch, func(path string, entry os.DirEntry, walkErr error) error {
+		if walkErr != nil {
+			return walkErr
+		}
+		if entry.Type().IsRegular() {
+			info, err := entry.Info()
+			if err != nil {
+				return err
+			}
+			if info.Size() < 8<<20 {
+				body, err := os.ReadFile(path)
+				if err != nil {
+					return err
+				}
+				if strings.Contains(string(body), credential) {
+					t.Error("credential persisted in private CLI state")
+				}
+			}
+		}
+		return nil
+	})
+	if err != nil || h.ExitCode() != 0 {
+		t.Fatalf("synthetic gateway command failed: %v", err)
+	}
+}
diff --git a/tools/orchestrator/internal/host/claude_test.go b/tools/orchestrator/internal/host/claude_test.go
new file mode 100644
index 00000000..a7b72780
--- /dev/null
+++ b/tools/orchestrator/internal/host/claude_test.go
@@ -0,0 +1,245 @@
+package host
+
+import (
+	"context"
+	"errors"
+	"github.com/GuanJHCode/Agent-Bird/tools/orchestrator/internal/adapter"
+	"github.com/GuanJHCode/Agent-Bird/tools/orchestrator/internal/contract"
+	"github.com/GuanJHCode/Agent-Bird/tools/orchestrator/internal/process"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+type claudeGatewayBranchInvocation struct {
+	launchInvocation
+	profile   *adapter.ExecutionProfile
+	action    *adapter.CandidateAction
+	workspace *adapter.CandidateWorkspace
+}
+
+func (i claudeGatewayBranchInvocation) OutputProvider() string                      { return string(adapter.ProviderClaude) }
+func (i claudeGatewayBranchInvocation) ExecutionProfile() *adapter.ExecutionProfile { return i.profile }
+func (i claudeGatewayBranchInvocation) CandidateAction() *adapter.CandidateAction   { return i.action }
+func (i claudeGatewayBranchInvocation) CandidateWorkspace() *adapter.CandidateWorkspace {
+	return i.workspace
+}
+
+func TestClaudeGatewayRejectsEveryUnsupportedBranchBeforeSpawn(t *testing.T) {
+	t.Setenv("ANTHROPIC_BASE_URL", "https://gateway.example.invalid")
+	for _, kind := range []string{"untyped", "implementer", "candidate-review", "candidate-workspace"} {
+		t.Run(kind, func(t *testing.T) {
+			root, _ := filepath.EvalSymlinks(t.TempDir())
+			h, err := NewIPC(filepath.Join(root, "spool"), "producer")
+			if err != nil {
+				t.Fatal(err)
+			}
+			inv := claudeGatewayBranchInvocation{launchInvocation: launchInvocation{args: []string{"/usr/bin/true"}, dir: root}, profile: &adapter.ExecutionProfile{Version: 1, Role: adapter.Reviewer, Permission: adapter.ReadOnly, TimeoutMS: 1000}}
+			switch kind {
+			case "untyped":
+				inv.profile = nil
+			case "implementer":
+				inv.profile.Role = adapter.Implementer
+				inv.profile.Permission = adapter.WorkspaceWrite
+			case "candidate-review":
+				inv.action = &adapter.CandidateAction{Operation: "review"}
+			case "candidate-workspace":
+				inv.workspace = &adapter.CandidateWorkspace{}
+			}
+			_, err = h.ExecuteLaunch(context.Background(), contract.LaunchCommand{CommandID: "c", ReservationID: "r", RunID: "run", TaskID: "task", AttemptID: "attempt", SegmentID: "segment", GrantedActiveMS: 1000}, inv)
+			if err == nil || err.Error() != "claude_gateway_readonly_required" {
+				t.Fatalf("unsupported branch admitted: %v", err)
+			}
+			if _, err := os.Stat(filepath.Join(root, "spool", "attempt")); !os.IsNotExist(err) {
+				t.Fatal("unsupported branch reached execute/spawn")
+			}
+		})
+	}
+}
+
+func claudeGatewayFixture(t *testing.T) (process.Command, *adapter.ExecutionProfile, string, claudeGatewaySource) {
+	t.Helper()
+	root, err := filepath.EvalSymlinks(t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	home, work := filepath.Join(root, "source-home"), filepath.Join(root, "work")
+	for _, dir := range []string{home, work} {
+		if err := os.Mkdir(dir, 0700); err != nil {
+			t.Fatal(err)
+		}
+	}
+	cmd := process.Command{Path: "/bin/sh", Args: []string{"-c", "printf ok"}, Dir: work}
+	profile := &adapter.ExecutionProfile{Version: 1, Role: adapter.Reviewer, Permission: adapter.ReadOnly, TimeoutMS: 5000}
+	source := claudeGatewaySource{env: map[string]string{"HOME": home, "ANTHROPIC_BASE_URL": "https://gateway.example.invalid/anthropic", "ANTHROPIC_AUTH_TOKEN": "SYNTHETIC_GATEWAY_CREDENTIAL", "NODE_OPTIONS": "--require untrusted.js", "HTTPS_PROXY": "http://untrusted.invalid", "DYLD_INSERT_LIBRARIES": "/untrusted.dylib"}, homes: []string{home}, checkManaged: func(context.Context) error { return nil }}
+	return cmd, profile, filepath.Join(root, "scratch"), source
+}
+
+func TestClaudeGatewayUsesExactPrivateEnvironmentWithoutCopyingAuth(t *testing.T) {
+	cmd, profile, scratch, source := claudeGatewayFixture(t)
+	prepared, err := prepareClaudeGateway(context.Background(), cmd, profile, scratch, source)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !prepared.ExactEnv || prepared.Path != "/usr/bin/sandbox-exec" {
+		t.Fatalf("gateway not isolated: %+v", prepared)
+	}
+	joined := strings.Join(prepared.Env, "\n")
+	for _, bad := range []string{"NODE_OPTIONS=", "HTTPS_PROXY=", "DYLD_INSERT_LIBRARIES=", "CLAUDE_CODE_OAUTH_TOKEN="} {
+		if strings.Contains(joined, bad) {
+			t.Fatalf("inherited environment %s", bad)
+		}
+	}
+	if !strings.Contains(joined, "HOME="+filepath.Join(scratch, "claude-home")) || !strings.Contains(joined, "CLAUDE_SECURESTORAGE_CONFIG_DIR="+filepath.Join(scratch, "claude-home/.claude")) {
+		t.Fatal("private state not selected")
+	}
+	if strings.Contains(strings.Join(prepared.Args, "\n"), source.env["ANTHROPIC_AUTH_TOKEN"]) {
+		t.Fatal("credential exposed in argv/SBPL")
+	}
+	for _, file := range []string{"mcp.json", "settings.json"} {
+		body, err := os.ReadFile(filepath.Join(scratch, "claude-home", "policy", file))
+		if err != nil || strings.Contains(string(body), "CREDENTIAL") {
+			t.Fatalf("config not private/minimal: %s", file)
+		}
+	}
+}
+
+func TestClaudeGatewayRejectsConflictingOrUnverifiedSources(t *testing.T) {
+	for _, kind := range []string{"oauth", "dual-key", "userinfo", "http", "query", "managed", "project", "reused-state"} {
+		t.Run(kind, func(t *testing.T) {
+			cmd, profile, scratch, source := claudeGatewayFixture(t)
+			switch kind {
+			case "oauth":
+				source.env["CLAUDE_CODE_OAUTH_TOKEN"] = "SYNTHETIC_OAUTH"
+			case "dual-key":
+				source.env["ANTHROPIC_API_KEY"] = "SYNTHETIC_SECOND_KEY"
+			case "userinfo":
+				source.env["ANTHROPIC_BASE_URL"] = "https://key@gateway.example.invalid"
+			case "http":
+				source.env["ANTHROPIC_BASE_URL"] = "http://gateway.example.invalid"
+			case "query":
+				source.env["ANTHROPIC_BASE_URL"] = "https://gateway.example.invalid?credential=x"
+			case "managed":
+				source.checkManaged = func(context.Context) error { return errors.New("managed") }
+			case "project":
+				if err := os.Mkdir(filepath.Join(cmd.Dir, ".claude"), 0700); err != nil {
+					t.Fatal(err)
+				}
+			case "reused-state":
+				if _, err := prepareClaudeGateway(context.Background(), cmd, profile, scratch, source); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if _, err := prepareClaudeGateway(context.Background(), cmd, profile, scratch, source); err == nil {
+				t.Fatal("unverified source admitted")
+			}
+		})
+	}
+}
+
+func TestClaudeGatewayNativeSandboxPreservesAuthAndWorkspaceBoundaries(t *testing.T) {
+	cmd, profile, scratch, source := claudeGatewayFixture(t)
+	secret := filepath.Join(source.homes[0], "oauth-sentinel")
+	if err := os.WriteFile(secret, []byte("SYNTHETIC_SOURCE_AUTH"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	cmd.Args = []string{"-c", `test ! -r "$1" && ! touch "$2/forbidden" 2>/dev/null && ! rm -rf "$TMPDIR/claude-home/policy" 2>/dev/null && touch "$TMPDIR/allowed" && printf ISOLATED`, "sh", secret, cmd.Dir}
+	prepared, err := prepareClaudeGateway(context.Background(), cmd, profile, scratch, source)
+	if err != nil {
+		t.Fatal(err)
+	}
+	handle, err := process.Start(context.Background(), prepared)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := handle.Wait(context.Background()); err != nil || handle.ExitCode() != 0 || handle.Output() != "ISOLATED" {
+		t.Fatalf("sandbox failed: exit=%d output=%q err=%v", handle.ExitCode(), handle.Output(), err)
+	}
+	if _, err := os.Stat(filepath.Join(scratch, "allowed")); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Stat(filepath.Join(cmd.Dir, "forbidden")); !os.IsNotExist(err) {
+		t.Fatal("workspace write allowed")
+	}
+	if body, err := os.ReadFile(filepath.Join(scratch, "claude-home/policy/settings.json")); err != nil || string(body) != "{}" {
+		t.Fatal("private policy was mutable")
