+func claudeLegacySeries(raw string) bool {
+	if AdmitVersion(ProviderClaude, raw) != nil {
+		return false
+	}
+	version, _ := parseCLIVersion(raw)
+	previousFloor, _ := parseCLIVersion("2.1.267")
+	return version.compare(previousFloor) < 0
+}
